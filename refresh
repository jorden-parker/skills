#!/usr/bin/env python3
"""Keep installed skills linked to this checkout."""

import argparse
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime
from uuid import uuid4


def known_versions(repo, source):
    versions = {source.read_bytes()}
    relative = source.relative_to(repo).as_posix()
    history = subprocess.run(
        ["git", "-C", str(repo), "log", "--all", "--format=%H", "--", relative],
        capture_output=True, text=True,
    )
    if history.returncode == 0:
        for commit in history.stdout.splitlines():
            result = subprocess.run(
                ["git", "-C", str(repo), "show", f"{commit}:{relative}"],
                capture_output=True,
            )
            if result.returncode == 0:
                versions.add(result.stdout)
    return versions


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("names", nargs="*", help="skill names (default: all repo skills)")
    parser.add_argument("--check", action="store_true", help="report without changing files; exit 1 if refresh or review is needed")
    args = parser.parse_args()
    repo = Path(__file__).resolve().parent
    sources = {p.parent.name: p.parent for p in (repo / "skills").glob("*/SKILL.md")}
    unknown = set(args.names) - sources.keys()
    if unknown:
        parser.error("unknown skills: " + ", ".join(sorted(unknown)))
    roots = dict.fromkeys([
        (Path.home() / ".agents/skills").absolute(),
        (Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser() / "skills").absolute(),
        (Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser() / "skills").absolute(),
    ])
    failed = False
    for name in sorted(args.names or sources):
        source = sources[name]
        versions = None
        for root in roots:
            target = root / name
            if not os.path.lexists(target):
                continue
            try:
                if target.is_symlink() and target.resolve() == source.resolve():
                    print(f"current  {target}")
                    continue
                if versions is None:
                    versions = known_versions(repo, source / "SKILL.md")
                manifest = target / "SKILL.md"
                if not manifest.is_file() or manifest.read_bytes() not in versions:
                    print(f"review   {target}: not a recognised copy; left untouched", file=sys.stderr)
                    failed = True
                    continue
                if args.check:
                    print(f"refresh  {target}")
                    failed = True
                    continue
                stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f") + "-" + uuid4().hex[:8]
                backup = root.parent / "skill-backups" / stamp / name
                backup.parent.mkdir(parents=True)
                target.rename(backup)
                try:
                    target.symlink_to(source, target_is_directory=True)
                except OSError:
                    backup.rename(target)
                    raise
                if target.resolve() != source.resolve() or not (target / "SKILL.md").is_file():
                    raise OSError("link verification failed")
                print(f"linked   {target} -> {source}\nbackup   {backup}")
            except (OSError, RuntimeError) as error:
                print(f"error    {target}: {error}", file=sys.stderr)
                failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
