+  binds="${binds}pos(1),tab:toggle,shift-tab:toggle,ctrl-a:select-all,ctrl-d:deselect-all"
 
   sel="$(while IFS=$'\t' read -r name state; do
-           printf '%s\t%s\t%s\n' "$name" "$state" "$(describe "$name")"
