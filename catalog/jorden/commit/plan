#!/usr/bin/env python3
"""Gather repo state for the commit skill, then build and render its plan."""

import argparse
import fnmatch
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

HEADER_PATTERN = re.compile(r"^(?P<type>[a-z]+)(\((?P<scope>[^)]+)\))?(?P<bang>!)?: (?P<subject>.+)$")
DEFAULT_IGNORE_SUBJECT = "ignore local files"
MAX_UNTRACKED_BYTES = 100 * 1024
LOCAL_ONLY_PATTERNS = {
    "node_modules/": "dependency folder",
    "dist/": "build output",
    "build/": "build output",
    "coverage/": "test coverage output",
    ".cache/": "cache folder",
    "__pycache__/": "Python bytecode cache",
    "*.pyc": "Python bytecode",
    "*.log": "log file",
    ".DS_Store": "macOS folder metadata",
    ".idea/": "editor settings",
    ".env": "local environment file",
    ".env.*": "local environment file",
    ".playwright-mcp/": "browser tool output",
}


class PlanError(Exception):
    pass


def git_output(*arguments):
    result = subprocess.run(["git", *arguments], capture_output=True, text=True, check=False)
    if result.returncode:
        raise PlanError(result.stderr.strip() or "git failed")
    return result.stdout.strip()


def plan_dir():
    git_dir = git_output("rev-parse", "--absolute-git-dir")
    branch = git_output("rev-parse", "--abbrev-ref", "HEAD")
    identity = branch if branch != "HEAD" else git_output("rev-parse", "HEAD")
    repo_key = hashlib.sha256(f"{git_dir}\n{identity}".encode()).hexdigest()[:16]
    base = Path(os.environ.get("SKILLS_TMPDIR") or "/tmp/claude-skills")
    directory = base / "commit" / repo_key
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    for level in (base / "commit", directory):
        level.mkdir(mode=0o700, exist_ok=True)
    return directory


def plan_path():
    return plan_dir() / "plan.json"


def save(plan):
    path = plan_path()
    path.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")


def parse_header(header):
    match = HEADER_PATTERN.match(header)
    if not match:
        raise PlanError(f"header must look like 'type(scope)!: subject', got '{header}'")
    return {
        "type": match["type"],
        "scope": match["scope"],
        "breaking": bool(match["bang"]),
        "subject": match["subject"],
    }


def section(title, body):
    return f"## {title}\n{body.strip()}\n"


def commitlint_config():
    parts = []
    for path in sorted([*Path(".").glob(".commitlintrc*"), *Path(".").glob("commitlint.config.*")]):
        parts.append(f"{path}\n{path.read_text(encoding='utf-8')}")
    package = Path("package.json")
    if package.exists():
        embedded = json.loads(package.read_text(encoding="utf-8")).get("commitlint")
        if embedded:
            parts.append(f"package.json#commitlint\n{json.dumps(embedded, indent=2)}")
    return "\n".join(parts)


def untracked_contents():
    names = git_output("ls-files", "--others", "--exclude-standard").splitlines()
    shown, skipped = [], []
    for name in names:
        path = Path(name)
        raw = path.read_bytes() if path.is_file() and path.stat().st_size <= MAX_UNTRACKED_BYTES else None
        if raw is None or b"\0" in raw:
            skipped.append(name)
        else:
            shown.append(f"### {name}\n{raw.decode('utf-8', errors='replace')}")
    if skipped:
        shown.append("skipped (binary or over 100 KB): " + ", ".join(skipped))
    return "\n".join(shown)


def load_render():
    path = Path(__file__).resolve().parent / "render"
    loader = importlib.machinery.SourceFileLoader("commit_render", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("commit_render", loader))
    loader.exec_module(module)
    return module


def convention_text():
    convention = load_render().read_convention(Path("."))
    scopes = " ".join(convention["scopes"]) if convention["scopes"] else "any"
    return f"types: {' '.join(convention['types'])}\nscopes: {scopes}\nmax header length: {convention['header_limit']}"


def matching_pattern(name):
    parts = name.split("/")
    for pattern in LOCAL_ONLY_PATTERNS:
        if pattern.endswith("/") and pattern[:-1] in parts[:-1]:
            return pattern
        if not pattern.endswith("/") and fnmatch.fnmatch(parts[-1], pattern):
            return pattern
    return None


def ignored_patterns():
    gitignore = Path(".gitignore")
    lines = gitignore.read_text(encoding="utf-8").splitlines() if gitignore.exists() else []
    return {line.strip().lstrip("/") for line in lines}


def ignore_candidates():
    untracked = git_output("ls-files", "--others", "--exclude-standard").splitlines()
    tracked = git_output("ls-files").splitlines()
    already = ignored_patterns()
    candidates = []
    for name, is_tracked in [*((name, False) for name in untracked), *((name, True) for name in tracked)]:
        pattern = matching_pattern(name)
        if pattern and pattern not in already:
            candidates.append({"path": name, "pattern": pattern, "reason": LOCAL_ONLY_PATTERNS[pattern], "tracked": is_tracked})
    return candidates


def candidates_text(candidates):
    return "\n".join(f"{item['path']} | {item['pattern']} | {item['reason']}" + (" | untrack" if item["tracked"] else "") for item in candidates)


def handle_gather(arguments):
    status = git_output("--no-optional-locks", "status", "--porcelain=v2", "--untracked-files=all")
    if not status:
        print("nothing to commit")
        return
    gitignore = Path(".gitignore")
    sections = [
        ("convention", convention_text()),
        ("ignore candidates", candidates_text(ignore_candidates())),
        ("commitlint config", commitlint_config()),
        ("recent subjects", git_output("log", "--format=%s", "-30")),
        (".gitignore", gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""),
        ("status", status),
        ("diff stat", git_output("diff", "HEAD", "--stat")),
        ("diff", git_output("diff", "HEAD")),
        ("untracked files", untracked_contents()),
    ]
    print("\n".join(section(title, body) for title, body in sections if body))


def changed_paths():
    entries = git_output("-c", "core.quotePath=false", "--no-optional-locks", "status", "--porcelain=v1", "-z", "--untracked-files=all")
    fields = entries.split("\0")
    paths, index = [], 0
    while index < len(fields) and fields[index]:
        code, name = fields[index][:2], fields[index][3:]
        paths.append(name)
        index += 1
        if "R" in code or "C" in code:
            paths.append(fields[index])
            index += 1
    return paths


def handle_skeleton(arguments):
    candidates = ignore_candidates()
    ignored = {item["path"] for item in candidates}
    paths = [name for name in changed_paths() if name not in ignored]
    skeleton = {"commits": [{"header": "TODO", "why": "TODO", "paths": paths}]}
    if candidates:
        skeleton["ignore"] = {
            "patterns": {item["pattern"]: item["reason"] for item in candidates},
            "subject": DEFAULT_IGNORE_SUBJECT,
            "untrack": [item["path"] for item in candidates if item["tracked"]],
        }
    print(json.dumps(skeleton, indent=2))


def commit_entry(raw, position, directory):
    if not raw.get("paths") and not raw.get("patch"):
        raise PlanError(f"commit {position} needs paths or patch")
    patch_name = None
    if raw.get("patch"):
        patch_name = f"patch-{position:02d}.diff"
        (directory / patch_name).write_text(raw["patch"], encoding="utf-8")
    return {
        **parse_header(raw.get("header", "")),
        "body": raw.get("body", ""),
        "paths": raw.get("paths", []),
        "patch": patch_name,
        "rationale": raw.get("why", ""),
    }


def ignore_entry(raw):
    patterns = raw.get("patterns", {})
    return {
        "subject": raw.get("subject") or DEFAULT_IGNORE_SUBJECT,
        "patterns": list(patterns),
        "reasons": patterns,
        "untrack": raw.get("untrack", []),
    }


def read_build_document():
    try:
        document = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise PlanError(f"stdin is not valid JSON: {error}")
    if not isinstance(document, dict) or not document.get("commits"):
        raise PlanError("JSON needs a non-empty commits list")
    return document


def handle_build(arguments):
    document = read_build_document()
    directory = plan_dir()
    plan = {
        "base": git_output("rev-parse", "HEAD"),
        "commits": [commit_entry(raw, position, directory) for position, raw in enumerate(document["commits"], 1)],
    }
    if document.get("ignore"):
        plan["ignore"] = ignore_entry(document["ignore"])
    if document.get("excluded"):
        plan["excluded"] = document["excluded"]
    save(plan)
    render = [sys.executable, str(Path(__file__).resolve().parent / "render"), str(plan_path())]
    return subprocess.run(render, check=False).returncode


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("gather", help="print what is needed to plan commits").set_defaults(handler=handle_gather)
    subcommands.add_parser("skeleton", help="print a starter build JSON for the working tree").set_defaults(handler=handle_skeleton)
    build = subcommands.add_parser("build", help="read plan JSON on stdin, write plan.json and render the page")
    build.set_defaults(handler=handle_build)
    return parser


def main():
    arguments = build_parser().parse_args()
    try:
        return arguments.handler(arguments) or 0
    except PlanError as error:
        print(f"plan: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
