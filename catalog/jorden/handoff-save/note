#!/usr/bin/env python3
"""Gather facts for a handoff note and check a finished note."""

import argparse
from datetime import datetime
import os
from pathlib import Path
import re
import subprocess
import sys

HEADINGS = [
    "Goal",
    "State",
    "Progress",
    "Relevant files",
    "Decisions",
    "Open questions / blockers",
    "Next steps",
    "Verification",
    "Suggested skills",
]
SECRET_PATTERN = re.compile(r"sk-|ghp_|AKIA|-----BEGIN|(password|token)=\S")


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def notes_directory():
    base = Path(os.environ.get("SKILLS_TMPDIR") or "/tmp/claude-skills")
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory = base / "handoff"
    directory.mkdir(mode=0o700, exist_ok=True)
    directory.chmod(0o700)
    return directory


def repo_name(top_level):
    return Path(top_level or os.getcwd()).name


def git_facts():
    unpushed = run("git", "log", "--oneline", "@{u}..")
    return [
        ("branch", run("git", "branch", "--show-current")),
        ("status", run("git", "status", "-s")),
        ("recent commits", run("git", "log", "--oneline", "-5")),
        ("unpushed commits", "no upstream" if unpushed is None else unpushed),
    ]


def handle_facts(arguments):
    top_level = run("git", "rev-parse", "--show-toplevel")
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    path = notes_directory() / f"{repo_name(top_level)}-{stamp}.md"
    sections = [("note path", str(path)), ("pwd", os.getcwd())]
    if top_level:
        sections += git_facts()
    print("\n".join(f"## {title}\n{body or ''}\n" for title, body in sections))
    return 0


def check_problems(text):
    problems = []
    headings = re.findall(r"^## (.+?)\s*$", text, re.MULTILINE)
    positions = [headings.index(heading) if heading in headings else None for heading in HEADINGS]
    problems += [f"missing heading: ## {heading}" for heading, position in zip(HEADINGS, positions) if position is None]
    found = [position for position in positions if position is not None]
    if found != sorted(found):
        problems.append("headings out of order; expected: " + ", ".join(HEADINGS))
    for number, line in enumerate(text.splitlines(), 1):
        if SECRET_PATTERN.search(line):
            problems.append(f"line {number} looks like a secret; remove it")
    return problems


def handle_check(arguments):
    problems = check_problems(Path(arguments.file).read_text(encoding="utf-8"))
    for problem in problems:
        print(f"note: {problem}", file=sys.stderr)
    return 1 if problems else 0


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("facts", help="print the note path and git facts").set_defaults(handler=handle_facts)
    check = subcommands.add_parser("check", help="fail if the note has missing sections or secrets")
    check.add_argument("file")
    check.set_defaults(handler=handle_check)
    return parser


if __name__ == "__main__":
    arguments = build_parser().parse_args()
    sys.exit(arguments.handler(arguments))
