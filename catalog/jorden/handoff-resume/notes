#!/usr/bin/env python3
"""List this repo's newest handoff notes and pick one."""

from datetime import datetime
import os
from pathlib import Path
import subprocess
import sys

LIST_LIMIT = 5


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def notes_directory():
    return Path(os.environ.get("SKILLS_TMPDIR") or "/tmp/claude-skills") / "handoff"


def repo_name(top_level):
    return Path(top_level or os.getcwd()).name


def newest_notes(name):
    directory = notes_directory()
    found = directory.glob(f"{name}-*.md") if directory.is_dir() else []
    return sorted(found, key=lambda path: path.stat().st_mtime, reverse=True)[:LIST_LIMIT]


def age(path):
    seconds = int(datetime.now().timestamp() - path.stat().st_mtime)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds // size}{unit} ago"
    return "just now"


def choose(notes, word):
    if not word:
        return notes[0]
    matching = [path for path in notes if word.lower() in path.read_text(encoding="utf-8", errors="replace").lower()]
    return matching[0] if matching else notes[0]


def git_state():
    state = [("branch", run("git", "branch", "--show-current")), ("recent commits", run("git", "log", "--oneline", "-10"))]
    status = run("git", "status", "--short")
    state.append(("status", "\n".join((status or "").splitlines()[:40])))
    return state


def main():
    top_level = run("git", "rev-parse", "--show-toplevel")
    notes = newest_notes(repo_name(top_level))
    if not notes:
        print("no notes")
        return 0
    print("## notes")
    print("\n".join(f"{path} ({age(path)})" for path in notes))
    print(f"\n## chosen\n{choose(notes, ' '.join(sys.argv[1:]))}\n")
    if top_level:
        print("\n".join(f"## {title}\n{body or ''}\n" for title, body in git_state()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
