#!/usr/bin/env python3
"""Build the commit skill's plan.json one entry at a time."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

HEADER_PATTERN = re.compile(r"^(?P<type>[a-z]+)(\((?P<scope>[^)]+)\))?(?P<bang>!)?: (?P<subject>.+)$")
DEFAULT_IGNORE_SUBJECT = "ignore local files"


class PlanError(Exception):
    pass


def git_output(*arguments):
    result = subprocess.run(["git", *arguments], capture_output=True, text=True, check=False)
    if result.returncode:
        raise PlanError(result.stderr.strip() or "git failed")
    return result.stdout.strip()


def plan_dir():
    git_dir = git_output("rev-parse", "--absolute-git-dir")
    branch = git_output("rev-parse", "--abbrev-ref", "HEAD")
    identity = branch if branch != "HEAD" else git_output("rev-parse", "HEAD")
    repo_key = hashlib.sha256(f"{git_dir}\n{identity}".encode()).hexdigest()[:16]
    base = Path(os.environ.get("SKILLS_TMPDIR") or "/tmp/claude-skills")
    directory = base / "commit" / repo_key
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    for level in (base / "commit", directory):
        level.mkdir(mode=0o700, exist_ok=True)
    return directory


def plan_path():
    return plan_dir() / "plan.json"


def load():
    path = plan_path()
    if not path.exists():
        raise PlanError("run `plan new` first")
    return json.loads(path.read_text(encoding="utf-8"))


def save(plan):
    path = plan_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
    print(path)


def parse_header(header):
    match = HEADER_PATTERN.match(header)
    if not match:
        raise PlanError(f"header must look like 'type(scope)!: subject', got '{header}'")
    return {
        "type": match["type"],
        "scope": match["scope"],
        "breaking": bool(match["bang"]),
        "subject": match["subject"],
    }


def handle_dir(arguments):
    print(plan_dir())


def handle_new(arguments):
    save({"base": git_output("rev-parse", "HEAD"), "commits": []})


def handle_commit(arguments):
    if not arguments.paths and not arguments.patch:
        raise PlanError("commit needs PATH or --patch")
    commit = {
        **parse_header(arguments.header),
        "body": arguments.body,
        "paths": arguments.paths,
        "patch": arguments.patch,
        "rationale": arguments.why,
    }
    plan = load()
    plan["commits"].append(commit)
    save(plan)


def handle_ignore(arguments):
    plan = load()
    block = plan.setdefault("ignore", {"subject": DEFAULT_IGNORE_SUBJECT, "patterns": [], "reasons": {}, "untrack": []})
    block["patterns"].append(arguments.pattern)
    block["reasons"][arguments.pattern] = arguments.reason
    block["untrack"].extend(arguments.untrack)
    if arguments.subject:
        block["subject"] = arguments.subject
    save(plan)


def handle_exclude(arguments):
    plan = load()
    plan.setdefault("excluded", []).append({"path": arguments.path, "reason": arguments.reason})
    save(plan)


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("dir", help="print the plan directory").set_defaults(handler=handle_dir)
    subcommands.add_parser("new", help="start an empty plan at HEAD").set_defaults(handler=handle_new)

    commit = subcommands.add_parser("commit", help="append a commit")
    commit.add_argument("header")
    commit.add_argument("--why", required=True)
    commit.add_argument("--body", default="")
    commit.add_argument("--patch")
    commit.add_argument("paths", nargs="*")
    commit.set_defaults(handler=handle_commit)

    ignore = subcommands.add_parser("ignore", help="add an ignore pattern")
    ignore.add_argument("pattern")
    ignore.add_argument("--reason", required=True)
    ignore.add_argument("--subject")
    ignore.add_argument("--untrack", nargs="+", default=[])
    ignore.set_defaults(handler=handle_ignore)

    exclude = subcommands.add_parser("exclude", help="leave a path out of the plan")
    exclude.add_argument("path")
    exclude.add_argument("--reason", required=True)
    exclude.set_defaults(handler=handle_exclude)
    return parser


def main():
    arguments = build_parser().parse_args()
    try:
        arguments.handler(arguments)
    except PlanError as error:
        print(f"plan: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
