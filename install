#!/usr/bin/env bash
# Install and toggle the skills in this repo.
#
# A skill is "on" when ~/.agents/skills/<name> is a symlink into this
# checkout, and "off" when that link is absent. The two partial states,
# name-only and user-invocable-only, keep the link and add a skillOverrides
# entry in settings.json. See docs/adr/0003.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$REPO_DIR/skills"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
LINK_DIR="$HOME/.agents/skills"
SETTINGS="$CLAUDE_DIR/settings.json"
STATES="$(mktemp -t skillstates)"
BEFORE="$(mktemp -t skillstates-before)"
trap 'rm -f "$STATES" "$STATES.new" "$STATES.apply" "$BEFORE"' EXIT

VALID_STATES="on off name-only user-invocable-only"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
dim()  { printf '\033[2m%s\033[0m\n' "$1"; }
warn() { printf '  \033[33mskip\033[0m %s\n' "$1"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }
state_colour() { # $1 state -> coloured, padded to 19 columns
  local c
  case "$1" in
    on)  c='32' ;;   # green
    off) c='31' ;;   # red
    *)   c='33' ;;   # yellow: name-only, user-invocable-only
  esac
  printf '\033[%sm%-19s\033[0m' "$c" "$1"
}
state_tag() { # $1 state -> yellow "[state] " prefix for states the picker cannot express, else nothing
  case "$1" in
    on|off) ;;
    *) printf '\033[33m[%s]\033[0m ' "$1" ;;
  esac
}

usage() {
  cat <<'USAGE'
Usage: ./install [options]

  (no options)     Interactive: pick which skills are on.
  --list           Show each skill and its current state.
  --add NAME       Link a skill into ~/.agents/skills. Repeatable.
  --remove NAME    Remove a skill's link. Repeatable.
  --set NAME=STATE Set one skill's state directly. Repeatable.
  --sync           Repair links that point at an old checkout and drop links
                   whose skill left the repo. Adds nothing. No prompts.
  --help

States: on, off, name-only, user-invocable-only
  on                    Linked. Fully visible to you and to Claude.
  off                   Not linked. Hidden everywhere.
  name-only             Linked. Claude sees the name, not the description.
  user-invocable-only   Linked. You can /invoke it; Claude cannot reach for it itself.

Adding or removing a skill needs a NEW Claude Code session to take effect.
USAGE
}

# ---------- JSON backend ----------
json_tool=""
if command -v jq >/dev/null 2>&1; then json_tool="jq"
elif command -v python3 >/dev/null 2>&1; then json_tool="python3"
else die "need either jq or python3 to edit $SETTINGS"; fi

read_overrides() { # -> "name<TAB>state" lines
  [ -f "$SETTINGS" ] || return 0
  if [ "$json_tool" = "jq" ]; then
    jq -r '(.skillOverrides // {}) | to_entries[] | "\(.key)\t\(.value)"' "$SETTINGS" 2>/dev/null || true
  else
    python3 - "$SETTINGS" <<'PY' 2>/dev/null || true
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for k,v in (d.get("skillOverrides") or {}).items():
    print(f"{k}\t{v}")
PY
  fi
}

write_overrides() { # stdin: "name<TAB>state" lines; "on" and "off" entries are removed
  local pairs; pairs="$(cat)"
  mkdir -p "$CLAUDE_DIR"
  [ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
  cp "$SETTINGS" "$SETTINGS.bak"
  if [ "$json_tool" = "jq" ]; then
    printf '%s\n' "$pairs" \
      | jq -R -s 'split("\n") | map(select(length>0) | split("\t") | {(.[0]): .[1]}) | add // {}' \
      | jq -s '.[0] as $cur | .[1] as $new
               | $cur + { skillOverrides: (($cur.skillOverrides // {}) + $new | with_entries(select(.value != "on" and .value != "off"))) }
               | if (.skillOverrides | length) == 0 then del(.skillOverrides) else . end' \
        "$SETTINGS" - > "$SETTINGS.tmp"
  else
    # The script arrives on stdin via the heredoc, so the pairs cannot also
    # come through stdin. Pass them as an argument instead.
    python3 - "$SETTINGS" "$SETTINGS.tmp" "$pairs" <<'PY'
import json,sys
settings,out,pairs=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(settings))
ov=d.get("skillOverrides") or {}
for line in pairs.split("\n"):
    if not line: continue
    k,_,v=line.partition("\t")
    ov[k]=v
ov={k:v for k,v in ov.items() if v not in ("on","off")}
if ov: d["skillOverrides"]=ov
else: d.pop("skillOverrides",None)
json.dump(d,open(out,"w"),indent=2)
open(out,"a").write("\n")
PY
  fi
  mv "$SETTINGS.tmp" "$SETTINGS"
}

# ---------- skills ----------
list_skills() {
  [ -d "$SRC_DIR" ] || die "no skills/ directory in $REPO_DIR"
  find "$SRC_DIR" -mindepth 2 -maxdepth 2 -name SKILL.md -print \
    | sed "s|$SRC_DIR/||; s|/SKILL.md||" | sort
}

describe() { # $1 = skill name
  sed -n 's/^description: *//p' "$SRC_DIR/$1/SKILL.md" | head -1 | cut -c1-90
}

is_linked() { # $1 = skill name -> 0 when ~/.agents/skills/<name> exists
  [ -e "$LINK_DIR/$1" ] || [ -L "$LINK_DIR/$1" ]
}

link_skill() { # $1 = skill name -> 0 when linked, 1 when a real directory blocks it
  local name="$1" target="$LINK_DIR/$1"
  mkdir -p "$LINK_DIR"
  if [ -L "$target" ]; then
    ln -sfn "$SRC_DIR/$name" "$target"
  elif [ -e "$target" ]; then
    warn "$name - a real directory is already there, not touching it"
    return 1
  else
    ln -s "$SRC_DIR/$name" "$target"
  fi
}

unlink_skill() { # $1 = skill name -> 0 when absent afterwards, 1 when a real directory blocks it
  local name="$1" target="$LINK_DIR/$1"
  if [ -L "$target" ]; then
    rm "$target"
  elif [ -e "$target" ]; then
    warn "$name - a real directory is there, not deleting it"
    return 1
  fi
}

apply_state() { # $1 name, $2 state -> links or unlinks, then records the result
  local name="$1" state="$2"
  if [ "$state" = "off" ]; then
    unlink_skill "$name" || state="on"
  else
    link_skill "$name" || true
  fi
  set_state "$name" "$state"
}

load_states() { # writes name<TAB>state for every skill in the repo
  local overrides; overrides="$(read_overrides)"
  : > "$STATES"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    local state="off"
    if is_linked "$name"; then
      state="$(printf '%s\n' "$overrides" | awk -F'\t' -v n="$name" '$1==n{print $2}' | head -1)"
      case " $VALID_STATES " in *" $state "*) ;; *) state="on" ;; esac
      [ "$state" = "off" ] && state="on"
    fi
    printf '%s\t%s\n' "$name" "$state" >> "$STATES"
  done <<< "$(list_skills)"
}

set_state() { # $1 name, $2 state
  awk -F'\t' -v n="$1" -v s="$2" 'BEGIN{OFS="\t"} $1==n{$2=s} {print}' "$STATES" > "$STATES.new"
  mv "$STATES.new" "$STATES"
}

show_list() {
  printf '\n'
  bold "Skills in $REPO_DIR/skills"
  printf '\n'
  while IFS=$'\t' read -r name state; do
    printf '  %s %-14s %s\n' "$(state_colour "$state")" "$name" "$(describe "$name")"
  done < "$STATES"
  printf '\n'
  dim "  on, name-only and user-invocable-only are linked into $LINK_DIR; off is not"
  printf '\n'
}

show_changes() { # diff $BEFORE against $STATES, one line per changed skill
  local changed=0 name before after
  while IFS=$'\t' read -r name after; do
    before="$(awk -F'\t' -v n="$name" '$1==n{print $2}' "$BEFORE")"
    [ "$before" = "$after" ] && continue
    if [ "$changed" -eq 0 ]; then
      printf '\n'
      bold "Changed"
      changed=1
    fi
    printf '  %-14s %s -> %s\n' "$name" "$(state_colour "$before")" "$(state_colour "$after")"
  done < "$STATES"
  [ "$changed" -eq 1 ] || { printf '\n'; dim "No states changed."; }
}

save() { # apply every state in $STATES to the filesystem and settings.json
  local name state
  cp "$STATES" "$STATES.apply"
  while IFS=$'\t' read -r name state; do apply_state "$name" "$state"; done < "$STATES.apply"
  write_overrides < "$STATES"
}

# ---------- interactive ----------
pick_with_fzf() {
  local sel binds i
  # Pre-select the rows that are currently linked, so the picker opens showing
  # the real state. fzf has no per-row select flag; the load event walks the
  # rows by position instead. Positions are 1-based input line numbers.
  binds='load:'
  i=0
  while IFS=$'\t' read -r _ state; do
    i=$((i+1))
    [ "$state" = "off" ] || binds="${binds}pos($i)+select+"
  done < "$STATES"
  binds="${binds}pos(1),tab:toggle,shift-tab:toggle,ctrl-a:select-all,ctrl-d:deselect-all"

  sel="$(while IFS=$'\t' read -r name state; do
           printf '%s\t%s\t%s%s\n' "$name" "$state" "$(state_tag "$state")" "$(describe "$name")"
         done < "$STATES" \
         | fzf --multi --ansi --with-nth=1,3 --delimiter='\t' \
               --marker='✓ ' --pointer='▸ ' \
               --color='marker:green,pointer:cyan' \
               --header=$'✓ = linked after ENTER, no mark = link removed.\nTAB toggles (cursor stays put), ctrl-a all, ctrl-d none, ENTER saves, ESC quits.' \
               --preview="sed -n '1,25p' $SRC_DIR/{1}/SKILL.md" \
               --preview-window=right:60%:wrap \
               --bind="$binds" \
           | cut -f1)" || true
  if [ -z "$sel" ]; then
    printf '\nNothing selected - leaving states unchanged.\n'
    printf 'To remove everything, use: ./install --remove NAME\n'
    return 1
  fi
  # Selected rows keep a partial state if they had one; unselected rows go off.
  while IFS=$'\t' read -r name state; do
    if printf '%s\n' "$sel" | grep -qx "$name"; then
      [ "$state" = "off" ] && set_state "$name" "on"
    else
      set_state "$name" "off"
    fi
  done < "$STATES"
  return 0
}

pick_with_menu() {
  local names=() i choice name cur next
  while IFS=$'\t' read -r name _; do names+=("$name"); done < "$STATES"
  while true; do
    printf '\n'
    bold "Toggle a skill (number cycles its state), or press ENTER to save"
    printf '\n'
    i=1
    while IFS=$'\t' read -r name state; do
      local before flag=" "
      before="$(awk -F'\t' -v n="$name" '$1==n{print $2}' "$BEFORE")"
      [ "$before" = "$state" ] || flag="*"
      printf '  %d) %s %-14s %s\n' "$i" "$flag" "$name" "$(state_colour "$state")"
      i=$((i+1))
    done < "$STATES"
    printf '\n  * = changed this session\n  q) quit without saving\n\n'
    printf 'choice: '
    read -r choice || choice=""
    case "$choice" in
      "") return 0 ;;
      q|Q) return 1 ;;
      *[!0-9]*|"") printf 'not a number\n'; continue ;;
    esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#names[@]}" ]; then
      printf 'out of range\n'; continue
    fi
    name="${names[$((choice-1))]}"
    cur="$(awk -F'\t' -v n="$name" '$1==n{print $2}' "$STATES")"
    case "$cur" in
      on)                  next="off" ;;
      off)                 next="name-only" ;;
      name-only)           next="user-invocable-only" ;;
      user-invocable-only) next="on" ;;
      *)                   next="on" ;;
    esac
    set_state "$name" "$next"
  done
}

# ---------- main ----------
SETS=()
MODE="interactive"
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --list|-l) MODE="list" ;;
    --sync)    MODE="sync" ;;
    --add)     shift; SETS+=("${1:-}=on"); MODE="set" ;;
    --add=*)   SETS+=("${1#--add=}=on"); MODE="set" ;;
    --remove|--unlink)   shift; SETS+=("${1:-}=off"); MODE="set" ;;
    --remove=*)          SETS+=("${1#--remove=}=off"); MODE="set" ;;
    --unlink=*)          SETS+=("${1#--unlink=}=off"); MODE="set" ;;
    --set)     shift; SETS+=("${1:-}"); MODE="set" ;;
    --set=*)   SETS+=("${1#--set=}"); MODE="set" ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

[ -d "$SRC_DIR" ] || die "no skills/ directory in $REPO_DIR"
load_states
cp "$STATES" "$BEFORE"

case "$MODE" in
  list)
    show_list
    exit 0
    ;;
  set)
    for pair in "${SETS[@]}"; do
      name="${pair%%=*}"; state="${pair#*=}"
      [ -n "$name" ] && [ "$name" != "$pair" ] || die "expected NAME=STATE, got: $pair"
      grep -qx "$name" <<< "$(list_skills)" || die "no such skill: $name"
      case " $VALID_STATES " in *" $state "*) ;; *) die "bad state: $state (valid: $VALID_STATES)" ;; esac
      set_state "$name" "$state"
    done
    save
    show_list
    show_changes
    dim "Start a new Claude Code session for this to take effect."
    exit 0
    ;;
  sync)
    printf '\n'
    bold "Syncing links in $LINK_DIR"
    while IFS=$'\t' read -r name state; do
      [ "$state" = "off" ] && continue
      if [ -L "$LINK_DIR/$name" ] && [ "$(readlink "$LINK_DIR/$name")" != "$SRC_DIR/$name" ]; then
        link_skill "$name" && printf '  relinked %s\n' "$name"
      fi
    done < "$STATES"
    # Links into this checkout whose skill no longer exists in the repo.
    if [ -d "$LINK_DIR" ]; then
      for target in "$LINK_DIR"/*; do
        [ -L "$target" ] || continue
        case "$(readlink "$target")" in "$SRC_DIR"/*) ;; *) continue ;; esac
        [ -e "$target" ] && continue
        rm "$target"
        printf '  removed %s (no longer in the repo)\n' "$(basename "$target")"
      done
    fi
    write_overrides < "$STATES"
    show_list
    dim "Start a new Claude Code session for this to take effect."
    exit 0
    ;;
esac

# interactive - refuse before touching anything if there is no terminal
[ -t 0 ] || die "not a terminal - use --add, --remove, --set or --sync instead"

if command -v fzf >/dev/null 2>&1; then
  pick_with_fzf || exit 0
else
  dim "(install fzf for a nicer picker)"
  pick_with_menu || { printf 'no changes written\n'; exit 0; }
fi

save
show_list
show_changes
printf '\n'
bold "Saved to $SETTINGS"
dim "A backup of the previous file is at $SETTINGS.bak"
dim "Start a new Claude Code session for this to take effect."
